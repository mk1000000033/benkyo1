# このファイルをコピーして .env.local という名前にし、値を書き換えてください。
# 値は Supabase ダッシュボード → Project Settings → API (API Keys) で確認できます。

# Project URL（公開してよい値）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon key（または publishable key「sb_publishable_...」）（公開してよい値）
NEXT_PUBLIC_SUPABASE_ANON_KEY=ここにanonキー

# service_role key（または secret key「sb_secret_...」）
# ★絶対に公開しない・GitHubに上げない。先頭に NEXT_PUBLIC_ を付けないこと。
SUPABASE_SERVICE_ROLE_KEY=ここにservice_roleキー
