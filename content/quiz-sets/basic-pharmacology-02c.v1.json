        {
          "id": "a",
          "text": "オピオイド型"
        },
        {
          "id": "b",
          "text": "コカイン"
        },
        {
          "id": "c",
          "text": "ニコチン"
        },
        {
          "id": "d",
          "text": "幻覚薬型（LSD）"
