  "questions": [
    {
      "id": "q01",
      "type": "choice",
      "tags": [
        "innate"
      ],
      "prompt": "自然免疫に関する記述として正しいものはどれか。",
      "options": [
        {
          "id": "a",
          "text": "抗体を産生する"
        },
        {
          "id": "b",
          "text": "外敵を貪食する"
        },
        {
          "id": "c",
          "text": "T細胞抗原受容体（TCR）で抗原を認識する"
        },
        {
          "id": "d",
          "text": "メモリー（記憶）細胞を残す"
        }
      ],
      "answer": "b",
      "explanation": "自然免疫は ==食細胞が外敵を貪食する== など、すぐに働く防御です。抗体産生・TCRでの認識・記憶細胞は **獲得免疫** の特徴です。",
      "sourcePage": "問1"
    },
    {
      "id": "q02",
      "type": "choice",
      "tags": [
        "innate"
      ],
      "prompt": "自然免疫の特徴として正しいものはどれか。",
      "options": [
        {
          "id": "a",
          "text": "生まれつき備わっていて、異物が侵入した初期からすぐに働く"
        },
        {
          "id": "b",
          "text": "異物に対する抗原特異性が高い"
        },
        {
          "id": "c",
          "text": "細胞性免疫と体液性免疫に分類される"
        },
        {
          "id": "d",
          "text": "2回目の感染では1回目より強く反応する"
        }
      ],
      "answer": "a",
      "explanation": "自然免疫は ==先天的== に備わっていて、==感染の初期== から働きます。ほかの3つは獲得免疫の特徴です。",
      "sourcePage": "問1・問7"
    },
    {
      "id": "q03",
      "type": "choice",
      "tags": [
        "innate"
      ],
      "prompt": "パターン認識受容体（PRR）に関する記述として正しいものはどれか。",
      "options": [
        {
          "id": "a",
          "text": "主にT細胞に発現している"
