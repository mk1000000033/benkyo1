  "questions": [
    {
      "id": "q01",
      "type": "choice",
      "tags": [
        "innate"
      ],
      "prompt": "自然免疫に関する記述として正しいものはどれか。",
      "options": [
        {
          "id": "a",
          "text": "抗体を産生する"
        },
        {
          "id": "b",
          "text": "外敵を貪食する"
        },
        {
          "id": "c",
          "text": "T細胞抗原受容体（TCR）で抗原を認識する"
        },
        {
          "id": "d",
          "text": "メモリー（記憶）細胞を残す"
        }
      ],
      "answer": "b",
      "explanation": "自然免疫は ==食細胞による貪食・殺菌== など。抗体産生・TCR・記憶細胞は **獲得免疫** の特徴です。",
      "sourcePage": "課題 問1"
    },
    {
      "id": "q02",
      "type": "choice",
      "tags": [
        "innate"
      ],
      "prompt": "自然免疫の特徴として正しいものはどれか。",
      "options": [
        {
          "id": "a",
          "text": "異物侵入初期に即時的に機能し（数時間後）、持続期間は短い"
        },
        {
          "id": "b",
          "text": "異物に対する抗原特異性が高い"
        },
        {
          "id": "c",
          "text": "病原体の曝露によって後天的に獲得される"
        },
        {
          "id": "d",
          "text": "軟骨魚類以上の脊椎動物にだけ存在する"
        }
      ],
      "answer": "a",
      "explanation": "自然免疫は ==先天的== で、==侵入初期に即時的（数時間後）== に働き、持続は短い。植物から哺乳類まで広く保存されています。",
      "sourcePage": "資料「自然免疫」"
    },
    {
      "id": "q03",
      "type": "fill",
      "tags": [
        "innate"
      ],
      "prompt": "自然免疫は免疫学的記憶を誘導しないため、病原体に何度さらされても免疫反応の大きさや強さは [[blank]]。",
      "options": [
        {
          "id": "a",
          "text": "変わらない"
        },
        {
          "id": "b",
          "text": "増強する"
        },
        {
          "id": "c",
          "text": "低下する"
        }
      ],
      "answer": "a",
      "explanation": "自然免疫は ==記憶なし → 反応は一定（変わらない）==。獲得免疫は記憶があるので増強します。",
      "sourcePage": "資料「自然免疫」"
    },
    {
      "id": "q04",
      "type": "choice",
      "tags": [
        "innate"
      ],
      "prompt": "気道粘膜で、異物を口に向かって排出する手段はどれか。",
      "options": [
        {
          "id": "a",
          "text": "繊毛運動"
        },
        {
          "id": "b",
          "text": "蠕動運動"
        },
        {
          "id": "c",
          "text": "タイトジャンクション"
        },
        {
          "id": "d",
          "text": "粘液・ムチン"
        }
      ],
      "answer": "a",
      "explanation": "気道粘膜は ==繊毛運動== で異物を口へ。蠕動運動は消化管、タイトジャンクションは上皮細胞間、粘液・ムチンは細菌の運動を妨害します。",
      "sourcePage": "教科書P.40"
    },
