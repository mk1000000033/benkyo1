              "静的な活動が中心 🪑"
            ],
            [
              "ふつう",
              "1.75",
              "軽作業・軽いスポーツを含む 🚶"
            ],
            [
              "高い",
              "2.00",
              "重労働・活発な運動習慣 🏃"
            ]
          ]
