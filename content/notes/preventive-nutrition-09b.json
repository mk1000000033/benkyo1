      "color": "mint",
      "sourcePage": "スライド4",
      "blocks": [
        {
          "type": "formula",
          "formula": "身体活動レベル ＝ 1日の総エネルギー消費量 ÷ 1日の基礎代謝量"
        },
        {
          "type": "table",
          "headers": [
            "レベル",
            "値",
            "どんな生活？"
          ],
          "rows": [
            [
              "低い",
