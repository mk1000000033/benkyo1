          "rows": [
            [
              "基礎代謝基準値",
              "体重1 kgあたりの基礎代謝量（kcal/kg体重/日）",
              "男女とも**1〜2歳で最大**、年齢とともに低下"
            ],
            [
              "安静時代謝量",
              "安静・**座位**・覚醒でのエネルギー消費量",
